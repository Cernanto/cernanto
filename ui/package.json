{
  "name": "@cernanto/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The Cernanto web UI: a console for the plane, every agent a conversation, served by the gateway.",
  "type": "module",
  "license": "BUSL-1.1",
  "scripts": {
    "gateway": "node scripts/gateway-client.mjs",
    "dev": "node scripts/gateway-client.mjs && vite",
    "build": "node scripts/gateway-client.mjs && vite build",
    "land": "node scripts/gateway-client.mjs && vite build --outDir ../cernanto/ui/bundle --emptyOutDir",
    "typecheck": "node scripts/gateway-client.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/gateway-client.mjs && eslint src"
  },
  "dependencies": {
    "@cernanto/package-format": "workspace:*",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
