// Generated by the platform: the tester runs the tests beside it. Do not edit.
import { runSuiteOnce } from '@cernanto/runtime-lib/tests';

/** The tester's verdict: how many tests passed and the failures. */
export interface TesterResult {
  passed: number;
  failures: { name: string; message: string }[];
}

/**
 * Runs every test file type-checked beside the module (the `src/*.test.ts`
 * files) against the deployed agent as a consumer of it.
 *
 * @param input - Ignored.
 * @returns How many tests passed and each failure with its name and
 *   message.
 */
export async function run(input: unknown): Promise<TesterResult> {
  void input;
  return runSuiteOnce(new URL('.', import.meta.url));
}
