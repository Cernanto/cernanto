{
  "name": "@cernanto/runtime-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tests": {
      "types": "./dist/tests.d.ts",
      "default": "./dist/tests.js"
    },
    "./package.json": "./package.json",
    "./calls": {
      "types": "./dist/calls.d.ts",
      "default": "./dist/calls.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./mcp": {
      "types": "./dist/lanes/mcp/index.d.ts",
      "default": "./dist/lanes/mcp/index.js"
    },
    "./openapi": {
      "types": "./dist/lanes/openapi/index.d.ts",
      "default": "./dist/lanes/openapi/index.js"
    },
    "./openapi-server": {
      "types": "./dist/lanes/openapi/server.d.ts",
      "default": "./dist/lanes/openapi/server.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1159.0",
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/lib-dynamodb": "3.1159.0",
    "@cernanto/system": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openapi-backend": "5.20.1",
    "zod": "^4.6.6"
  },
  "files": [
    "dist"
  ]
}
